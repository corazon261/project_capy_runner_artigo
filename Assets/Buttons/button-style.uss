.button_style {
    height: 41px;
    width: 101px;
    background-color: rgb(161, 153, 153);
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    -unity-font: url('project://database/Assets/Sprites/Ui/UI%20Game_Menu/Retro%20Gaming.ttf?fileID=12800000&guid=ccfe83ee6707275429316d51ca55dae7&type=3#Retro Gaming');
    -unity-font-definition: initial;
}

.button_style:hover {
    height: 41px;
    width: 101px;
    background-color: rgb(82, 80, 80);
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    -unity-font: url('project://database/Assets/Sprites/Ui/UI%20Game_Menu/Retro%20Gaming.ttf?fileID=12800000&guid=ccfe83ee6707275429316d51ca55dae7&type=3#Retro Gaming');
    -unity-font-definition: initial;
}

.button_style:active {
    height: 41px;
    width: 101px;
    background-color: rgb(46, 45, 45);
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    -unity-font: url('project://database/Assets/Sprites/Ui/UI%20Game_Menu/Retro%20Gaming.ttf?fileID=12800000&guid=ccfe83ee6707275429316d51ca55dae7&type=3#Retro Gaming');
    -unity-font-definition: initial;
}
