      m_Calls: []
  m_text: "Descri\xE7\xE3o: As on\xE7as-pintadas s\xE3o grandes felinos, sendo o
    terceiro maior do mundo ap\xF3s o tigre e o le\xE3o. Possuem uma pelagem amarelada
    com manchas pretas, que variam em forma e tamanho, o que lhes confere o nome
    \"pintada\"."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
