      m_Calls: []
  m_text: "Tamanho:\r\ncomprimento m\xE9dio de 41 cm e cauda de 15 cm, pesando entre
    1,5 a 3 quilos.\r\no zorrilho \xE9 mais pr\xF3ximo de fur\xF5es. Possuem uma
    pelagem escura com duas faixas brancas que iniciam-se na parte superior da cabe\xE7a
    e percorrem as laterais do corpo. \r\n"
  m_isRightToLeft: 0
