  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Nidifica\xE7\xE3o:\n Nidifica em ninhos coletivos, com aux\xEDlio dos
    machos e jovens no cuidado dos filhotes. S\xE3o constru\xEDdos com gravetos e
    folhas, escondidos na vegeta\xE7\xE3o com a f\xEAmea botando de quatro a sete
    ovos, e a incuba\xE7\xE3o dura cerca de 15 dias.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
