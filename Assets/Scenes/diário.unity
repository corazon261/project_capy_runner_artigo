      m_Calls: []
  m_text: "Reprodu\xE7\xE3o:\r\nDurante a \xE9poca de reprodu\xE7\xE3o, os machos
    intensificam sua colora\xE7\xE3o avermelhada. Durante a incuba\xE7\xE3o dos ovos,
    a f\xEAmea protege o ninho, enquanto o macho patrulha as redondezas para afastar
    predadores. Os ovos eclodem ap\xF3s 8 a 10 dias.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
