      objectReference: {fileID: 0}
    - target: {fileID: 153167701227953996, guid: d84aed13356abdb4fbd8579b66bee707, type: 3}
      propertyPath: DialogueContents.Array.data[0].Name
      value: "L\xFAcio"
      objectReference: {fileID: 0}
    - target: {fileID: 153167701227953996, guid: d84aed13356abdb4fbd8579b66bee707, type: 3}
      propertyPath: DialogueContents.Array.data[0].Text
      value: Haha! Pegamos uma capivara boa hoje rapazes
      objectReference: {fileID: 0}
    - target: {fileID: 153167701227953996, guid: d84aed13356abdb4fbd8579b66bee707, type: 3}
      propertyPath: DialogueContents.Array.data[1].Name
      value: "Carl\xE3o"
      objectReference: {fileID: 0}
    - target: {fileID: 153167701227953996, guid: d84aed13356abdb4fbd8579b66bee707, type: 3}
      propertyPath: DialogueContents.Array.data[1].Text
      value: "\xC9 hoje que eu compro minha lancha kk"
      objectReference: {fileID: 0}
    - target: {fileID: 153167701227953996, guid: d84aed13356abdb4fbd8579b66bee707, type: 3}
      propertyPath: DialogueContents.Array.data[2].Name
      value: Armando
      objectReference: {fileID: 0}
    - target: {fileID: 153167701227953996, guid: d84aed13356abdb4fbd8579b66bee707, type: 3}
      propertyPath: DialogueContents.Array.data[2].Text
      value: "Acho que vou passar no bar do zeca linux, algu\xE9m topa?"
      objectReference: {fileID: 0}
    - target: {fileID: 153167701227953996, guid: d84aed13356abdb4fbd8579b66bee707, type: 3}
      propertyPath: DialogueContents.Array.data[3].Name
      value: "Carl\xE3o"
      objectReference: {fileID: 0}
    - target: {fileID: 153167701227953996, guid: d84aed13356abdb4fbd8579b66bee707, type: 3}
      propertyPath: DialogueContents.Array.data[3].Text
      value: "S\xF3 bora!"
      objectReference: {fileID: 0}
    - target: {fileID: 153167701227953996, guid: d84aed13356abdb4fbd8579b66bee707, type: 3}
      propertyPath: DialogueContents.Array.data[4].Name
      value: "L\xFAcio"
      objectReference: {fileID: 0}
    - target: {fileID: 153167701227953996, guid: d84aed13356abdb4fbd8579b66bee707, type: 3}
      propertyPath: DialogueContents.Array.data[4].Text
      value: Vamo que hoje eu pago!
      objectReference: {fileID: 0}
    - target: {fileID: 153167701227953996, guid: d84aed13356abdb4fbd8579b66bee707, type: 3}
      propertyPath: DialogueContents.Array.data[5].Name
