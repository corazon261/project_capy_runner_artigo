PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    m_TransformParent: {fileID: 1178663410}
    m_Modifications:
    - target: {fileID: 153167701227953996, guid: d84aed13356abdb4fbd8579b66bee707, type: 3}
      propertyPath: Name
      value: Contrabandista 1
      objectReference: {fileID: 0}
    - target: {fileID: 153167701227953996, guid: d84aed13356abdb4fbd8579b66bee707, type: 3}
      propertyPath: Text
      value: "Haha, pegamos uma capivara s\xE1dia hoje, rapazes!"
      objectReference: {fileID: 0}
    - target: {fileID: 153167701227953996, guid: d84aed13356abdb4fbd8579b66bee707, type: 3}
      propertyPath: OneTime
